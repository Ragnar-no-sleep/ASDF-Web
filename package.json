{
  "name": "asdf-web",
  "version": "2.0.0",
  "description": "ASDF Web - Official website for ASDFASDFA ecosystem",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.cjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server.cjs",
    "serve:dev": "nodemon server.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high",
    "validate": "npm run lint && npm run test && npm run audit",
    "prepare": "simple-git-hooks || true",
    "scan": "node scripts/scan-ecosystem.cjs",
    "prebuild": "node scripts/scan-ecosystem.cjs"
  },
  "dependencies": {
    "@solana/spl-token": "^0.1.8",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "compression": "^1.7.4",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "three": "^0.160.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "7.28.6",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.42.1",
    "eslint": "^10.0.1",
    "eslint-plugin-html": "^8.0.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.5",
    "simple-git-hooks": "2.13.1",
    "supertest": "^7.2.2",
    "vite": "^6.0.0"
  },
  "overrides": {
    "glob": "^10.5.0",
    "minimatch": "^10.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ragnar-no-sleep/ASDF-Web.git"
  },
  "author": "ASDF Team",
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "sh ./scripts/pre-commit.sh"
  }
}
