# ASDF-Web Server Configuration
# Copy to .env and fill in values. NEVER commit .env to git.

# Server
PORT=3000
NODE_ENV=development
OPENAI_MODEL=gpt-5.2
OPENAI_MODEL_FALLBACK=gpt-4.1-mini
# OPENAI_API_KEY=

# Redis (optional — enables /api/redis proxy endpoint)
# REDIS_URL=redis://localhost:6379

# Redis API authentication (required in production if REDIS_URL is set)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REDIS_API_KEY=

# See api/.env.example for full API service configuration (Helius, JWT, DB, etc.)
